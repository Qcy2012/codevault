{
  "manifest_version": 3,
  "name": "CodeVault 代码收集器 (Edge 专版)",
  "version": "1.0",
  "description": "一键将网页上的代码保存到 CodeVault - 专为 Microsoft Edge 打造",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "https://codevault.qcyblog.dpdns.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "128": "icon.png"
  }
}