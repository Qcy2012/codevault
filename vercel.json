{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "crons": [
    {
      "path": "/api/status/cron",
      "schedule": "0 16 * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "api/cpp_stats"
    }
  }
}